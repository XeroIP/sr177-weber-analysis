{% set flatNav = nav | flattenNav %}
{% set idx = flatNav | navIndex(navKey) %}
{% set prevItem = flatNav[idx - 1] if idx > 0 else null %}
{% set nextItem = flatNav[idx + 1] if idx >= 0 and idx < (flatNav | length) - 1 else null %}
{% if prevItem or nextItem %}
<div class="page-nav">
  {% if prevItem %}<a href="{{ prevItem.url | url }}">&larr; {{ prevItem.label }}</a>{% else %}<span></span>{% endif %}
  {% if nextItem %}<a href="{{ nextItem.url | url }}">{{ nextItem.label }} &rarr;</a>{% endif %}
</div>
{% endif %}

{% if sectionLinks and sectionLinks.length %}
<nav class="section-jump" aria-labelledby="section-jump-title">
  <div class="section-jump-title" id="section-jump-title">In this page</div>
  <ul>
    {% for link in sectionLinks %}
      <li><a href="#{{ link.id }}">{{ link.label }}</a></li>
    {% endfor %}
  </ul>
</nav>
{% endif %}
<nav aria-label="Primary">
  <div class="nav-inner">
    <a class="nav-brand" href="{{ "/index.html" | url }}">SR-177 / Weber</a>
    {% for item in nav %}
      {% if item.children %}
        {% set isActive = item | isNavActive(navKey) %}
        <div class="nav-dropdown">
          <button class="nav-summary{% if isActive %} active{% endif %}" type="button" aria-haspopup="true">{{ item.label }}</button>
          <div class="nav-menu">
            {% for child in item.children %}
              <a href="{{ child.url | url }}"{% if child.key == navKey %} class="active" aria-current="page"{% endif %}>{{ child.label }}</a>
            {% endfor %}
          </div>
        </div>
      {% else %}
        <a href="{{ item.url | url }}"{% if item.key == navKey %} class="active" aria-current="page"{% endif %}>{{ item.label }}</a>
      {% endif %}
    {% endfor %}
  </div>
</nav>

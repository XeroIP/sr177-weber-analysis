<nav class="site-nav" aria-label="Primary">
  <div class="nav-inner">
    <a class="nav-brand" href="{{ "/index.html" | url }}">SR-177 / Weber</a>
    {% for item in nav %}
      {% set isActive = item | isNavActive(navKey) %}
      {% if item.children %}
        <div class="nav-dropdown">
          <a class="nav-summary{% if isActive %} active{% endif %}" href="{{ item.url | url }}"{% if item.key == navKey %} aria-current="page"{% endif %}>{{ item.label }}</a>
          <div class="nav-menu">
            {% for child in item.children %}
              <a href="{{ child.url | url }}"{% if child.key == navKey %} class="active" aria-current="page"{% endif %}>{{ child.label }}</a>
            {% endfor %}
          </div>
        </div>
      {% else %}
        <a href="{{ item.url | url }}"{% if isActive %} class="active"{% endif %}{% if item.key == navKey %} aria-current="page"{% endif %}>{{ item.label }}</a>
      {% endif %}
    {% endfor %}
  </div>
</nav>

  <style>
    .ref-list {
      counter-reset: ref-counter;
      list-style: none;
      padding: 0;
    }

    .ref-list li {
      counter-increment: ref-counter;
      display: grid;
      grid-template-columns: 40px 1fr;
      gap: 16px;
      padding: 16px 0;
      border-bottom: 1px solid var(--rule);
      align-items: start;
    }

    .ref-list li:last-child { border-bottom: none; }

    .ref-list li::before {
      content: counter(ref-counter);
      font-family: 'DM Mono', monospace;
      font-size: 12px;
      color: var(--accent);
      background: var(--highlight);
      width: 32px;
      height: 32px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      margin-top: 2px;
    }

    .ref-body { font-size: 15px; line-height: 1.5; }

    .ref-body .ref-org {
      font-family: 'DM Mono', monospace;
      font-size: 11px;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 0.06em;
      margin-bottom: 4px;
    }

    .ref-body .ref-title { font-weight: 600; margin-bottom: 2px; }

    .ref-body .ref-source {
      font-size: 13px;
      color: var(--muted);
      font-style: italic;
    }

    .ref-group-label {
      font-family: 'DM Mono', monospace;
      font-size: 11px;
      letter-spacing: 0.12em;
      color: white;
      background: var(--ink);
      text-transform: uppercase;
      padding: 10px 16px;
      margin: 32px 0 0;
    }
  </style>

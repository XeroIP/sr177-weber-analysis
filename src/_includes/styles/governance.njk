      margin: 28px 0;
    }

    .contact-card {
      background: white;
      padding: 24px 22px;
    }

    .contact-card .org {
      font-family: 'DM Mono', monospace;
      font-size: 11px;
      color: var(--accent);
      text-transform: uppercase;
      letter-spacing: 0.08em;
      margin-bottom: 8px;
    }

    .contact-card h3 {
      font-family: 'DM Serif Display', serif;
      font-size: 17px;
      margin-bottom: 8px;
    }

    .contact-card p {
      font-size: 13px;
      color: var(--muted);
      margin: 0;
    }

    .contact-card a {
      color: var(--accent);
      font-size: 13px;
      display: block;
      margin-top: 8px;
    }


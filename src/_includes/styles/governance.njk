      border: 1px solid var(--rule);
    }

    .resolution-list li {
      padding: 16px 20px;
      border-bottom: 1px solid var(--rule);
      background: white;
      font-size: 15px;
    }

    .resolution-list li:last-child { border-bottom: none; }

    .resolution-list li strong {
      font-family: 'DM Mono', monospace;
      font-size: 12px;
      color: var(--accent);
      display: block;
      margin-bottom: 4px;
    }
